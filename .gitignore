# ─────────────────────────────────────────────
# ENSAMBLIA — .gitignore
# ─────────────────────────────────────────────

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/

# ── Virtualenv ──
.venv/
venv/
env/
ENV/

# ── Django ──
*.log
db.sqlite3
db.sqlite3-journal
media/
staticfiles/

# ── Tests back ──
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/

# ── Variables de entorno ──
.env
.env.local
.env.*.local
ensamblia DB/.env
frontend/.env
frontend/.env.local
frontend/.env.*.local

# ── Node / Front ──
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/coverage/
frontend/.vite/
frontend/.vitest/
frontend/.eslintcache
frontend/.oxlintcache
*.local

# ── Docker / Infra ──
*.pid
minio-data/
ensamblia DB/minio-data/
ensamblia DB/ensamblia_db/
ensamblia DB/pgadmin/
pgadmin/

# ── IDE ──
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# ── OS ──
.DS_Store
Thumbs.db